# Server-side database access. Never expose this to the browser.
DATABASE_URL=

# Clerk Development environment
# Keep CLERK_SECRET_KEY server-only; never commit its value.
CLERK_SECRET_KEY=
# Safe for the browser; generated by Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Scheduled maintenance (required only for the maintenance cron route)
CRON_SECRET=

# Comma-separated Clerk user IDs allowed into /admin and admin APIs.
# Required only when using the admin surface.
FORGE_ADMIN_USER_IDS=
